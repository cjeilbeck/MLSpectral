import pandas as pd
from sklearn.model_selection import train_test_split, GridSearchCV, StratifiedKFold
from sklearn.preprocessing import StandardScaler,FunctionTransformer
from sklearn.svm import SVC
from sklearn.decomposition import PCA              
from sklearn.pipeline import Pipeline            
import matplotlib.pyplot as plt  
from scipy.signal import savgol_filter
from A_functions import haircut,read_data,indicesmav, indicescustomSVM,problemtype
import numpy as np
import seaborn as sns

def apply_savgol(x):
    return savgol_filter(x, window_length=51, polyorder=3, axis=1)
import os
import random

USE_SCALING = True
USE_PCA = False
USE_SAVGOL = True
HAIRCUT = True 
z = 42  # Seed
comp = 4 # PCA components
left= 206
right=910
#3648 wavelength values for reference, 345 - 1038nm



seed = 42
os.environ['PYTHONHASHSEED'] = str(seed)
random.seed(seed)
np.random.seed(seed)




test_sizeinput = 0.2

GUMCOMB = False
OAKONLY = True


INDICES = True
CUSTOM = False

if INDICES:
    HAIRCUT = False
    USE_SAVGOL = False

if CUSTOM:
    INDICES = False
    HAIRCUT = False
    USE_SAVGOL = False

KERNEL = 'linear' #try 'linear', 'poly', 'rbf', 'sigmoid'   linear performs best on spectral, rbf maybe multispectral
C = 1.0        # regularization
GAMMA = 'scale' # kernel coefficient 

data=pd.read_csv("CSVfiles/datacalibrated.csv")

if GUMCOMB:
    problem = 'binary'
elif OAKONLY:
    problem = 'oak'
else:
    problem = 'all'

data = problemtype(data, problem)
y = data['leaf_type']
x = data.drop(columns=['leaf_type','sample_id'])    



if HAIRCUT:
    x = haircut(x,left,right)
    print(f"trimmed wav:",x.columns[0],x.columns[-1])

if INDICES:
    x = indicesmav(x)
if CUSTOM:
    x = indicescustomSVM(x)



x_train,x_test,y_train,y_test = train_test_split(x,y,test_size=test_sizeinput,random_state=z,stratify=y)

pipeline_steps = []

if USE_SAVGOL:
    pipeline_steps.append(('savgol', FunctionTransformer(apply_savgol)))

if USE_SCALING:
    pipeline_steps.append(('scaler', StandardScaler()))

if USE_PCA:
    pipeline_steps.append(('pca', PCA(n_components=comp)))

pipeline_steps.append(('svm_model', SVC(kernel=KERNEL, C=C, gamma=GAMMA)))
model = Pipeline(pipeline_steps)


params = {'svm_model__kernel': ['rbf','linear'],'svm_model__C': [1,10,1e2,1e3,1e4],'svm_model__gamma': [1,0.1,0.001,0.0001,'scale']}




skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=z)
grid = GridSearchCV(model, param_grid=params, refit=True, verbose=2, cv=skf, n_jobs=-1)
grid.fit(x_train, y_train)
print(f"best accuracy: {grid.best_score_:.4f}")
print(f"best parameters: {grid.best_params_}")
results_df = pd.DataFrame(grid.cv_results_)



pd.set_option('display.max_colwidth', None)
results = results_df.sort_values(by='mean_test_score', ascending=False)
print(results[['params', 'mean_test_score', 'std_test_score']])

heatmap_data = results_df
pivot_table = heatmap_data.pivot(index='param_svm_model__C', columns='param_svm_model__kernel', values='mean_test_score')

plt.figure(figsize=(10, 8))
sns.heatmap(pivot_table, annot=True, cmap='viridis', fmt=".3f")
plt.ylabel('C Parameter')
plt.xlabel('Kernel Type')
plt.show()




